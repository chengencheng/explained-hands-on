// StudyCrew on Cloudflare Workers: static files in public/ plus server code in src/worker.js.
{
  "name": "studycrew",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "studycrew", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }
  ],
  // Delete old sign-ups every day at 03:00 UTC (keep data only for the test week).
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    // Turnstile's public test key (always passes). Replace with your own site key before real use.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "PLACE": "Library 2F"
  }
  // Secrets (never in this file): TURNSTILE_SECRET, and optionally CLASS_CODE.
  //   npx wrangler secret put TURNSTILE_SECRET
}
